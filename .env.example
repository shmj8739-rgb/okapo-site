# ===================================================
# 環境変数の設定例
# ---------------------------------------------------
# このファイルをコピーして .env を作成し、実際の値を入れてください
# （.env は .gitignore 済みのためGitには含まれません）。
#
# ローカルで Netlify Functions をテストする場合は `netlify dev` が
# この .env を自動的に読み込みます。
#
# 本番（Netlify）側では、Netlifyの管理画面
# Site configuration > Environment variables に同じ変数名で
# 値を設定してください（.env はNetlifyには自動反映されません）。
# ===================================================

# Stripeのテスト用シークレットキー（sk_test_... で始まる値）
# Stripeダッシュボード > 開発者 > APIキー から取得してください。
# 本番用キー（sk_live_...）は今回は使用しません。
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_OWN_TEST_KEY
